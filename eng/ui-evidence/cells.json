    "windowAdjustmentSurface": "WindowAdjustmentSurface",
    "nameEntry": "NameEntry",
    "settingsModal": "SettingsModal",
    "transferConflictModal": "TransferConflictModal",
    "settingsEntry": "SettingsEntryHint",
    "focusedRow": { "automationIdPrefix": "FileListRow_", "scope": [ "LeftFileList", "RightFileList" ], "note": "Append the exact entry name and match within its owning file list. The identifier is on the row container, is independent of focus and order, and is not a persistent filesystem identity. Live UIA exposure is not yet verified." },
    "deletionConfirmation": { "automationId": "DeletionConfirmation", "scope": "OperationBar", "note": "Declared on the existing operation content grid only while permanent deletion awaits confirmation. This declaration does not enable F8 input; live UIA exposure is not yet verified." }
  },
  "layout": {
    "elements": [
      "LeftPaneBorder",
      "RightPaneBorder",
      "LeftAddress",
      "RightAddress",
      "LeftStatus",
      "RightStatus",
      "LeftFileList",
      "RightFileList",
      "OperationBar",
      "OperationKeyHints"
    ],
    "disjointPairs": [
      [ "LeftPaneBorder", "RightPaneBorder" ],
      [ "LeftPaneBorder", "OperationBar" ],
      [ "RightPaneBorder", "OperationBar" ],
      [ "LeftAddress", "LeftStatus" ],
      [ "RightAddress", "RightStatus" ],
      [ "LeftAddress", "LeftFileList" ],
      [ "RightAddress", "RightFileList" ]
    ],
    "containedIn": [
      [ "LeftAddress", "LeftPaneBorder" ],
      [ "LeftStatus", "LeftPaneBorder" ],
      [ "LeftFileList", "LeftPaneBorder" ],
      [ "RightAddress", "RightPaneBorder" ],
      [ "RightStatus", "RightPaneBorder" ],
      [ "RightFileList", "RightPaneBorder" ],
      [ "OperationKeyHints", "OperationBar" ]
    ],
    "notExposed": []
  },
  "cells": [
    { "id": "observe-current-normal", "mode": "Observe", "status": "active", "scheme": "@current", "layout": "normal" },
    { "id": "observe-current-narrow", "mode": "Observe", "status": "active", "scheme": "@current", "layout": "narrow" },
    { "id": "observe-nene-dark-normal", "mode": "Observe", "status": "active", "scheme": "nene-dark", "layout": "normal", "requiresOwnedProfile": true },
    { "id": "observe-nene-dark-narrow", "mode": "Observe", "status": "active", "scheme": "nene-dark", "layout": "narrow", "requiresOwnedProfile": true },
    { "id": "observe-nene-light-normal", "mode": "Observe", "status": "active", "scheme": "nene-light", "layout": "normal", "requiresOwnedProfile": true },
    { "id": "observe-nene-light-narrow", "mode": "Observe", "status": "active", "scheme": "nene-light", "layout": "narrow", "requiresOwnedProfile": true },
    { "id": "observe-nene-black-normal", "mode": "Observe", "status": "active", "scheme": "nene-black", "layout": "normal", "requiresOwnedProfile": true },
    { "id": "observe-nene-black-narrow", "mode": "Observe", "status": "active", "scheme": "nene-black", "layout": "narrow", "requiresOwnedProfile": true },
    { "id": "observe-dracula-normal", "mode": "Observe", "status": "active", "scheme": "dracula", "layout": "normal", "requiresOwnedProfile": true },
    { "id": "observe-dracula-narrow", "mode": "Observe", "status": "active", "scheme": "dracula", "layout": "narrow", "requiresOwnedProfile": true },
    { "id": "observe-monokai-normal", "mode": "Observe", "status": "active", "scheme": "monokai", "layout": "normal", "requiresOwnedProfile": true },
    { "id": "observe-monokai-narrow", "mode": "Observe", "status": "active", "scheme": "monokai", "layout": "narrow", "requiresOwnedProfile": true },
    { "id": "observe-solarized-dark-normal", "mode": "Observe", "status": "active", "scheme": "solarized-dark", "layout": "normal", "requiresOwnedProfile": true },
    { "id": "observe-solarized-dark-narrow", "mode": "Observe", "status": "active", "scheme": "solarized-dark", "layout": "narrow", "requiresOwnedProfile": true },
    { "id": "observe-solarized-light-normal", "mode": "Observe", "status": "active", "scheme": "solarized-light", "layout": "normal", "requiresOwnedProfile": true },
    { "id": "observe-solarized-light-narrow", "mode": "Observe", "status": "active", "scheme": "solarized-light", "layout": "narrow", "requiresOwnedProfile": true },
    { "id": "observe-ubuntu-normal", "mode": "Observe", "status": "active", "scheme": "ubuntu", "layout": "normal", "requiresOwnedProfile": true },
    { "id": "observe-ubuntu-narrow", "mode": "Observe", "status": "active", "scheme": "ubuntu", "layout": "narrow", "requiresOwnedProfile": true },
    {
      "id": "ctrl-w-helper",
      "mode": "Input",
      "status": "active",
      "steps": [
        {
          "id": "open-mode",
          "key": "W",
          "modifiers": [ "Control" ],
          "expects": {
            "before": { "focus": [ "LeftFileList", "RightFileList" ], "present": [], "absent": [ "WindowAdjustmentHelper", "NameEntry" ] },
            "after": { "focus": [ "WindowAdjustmentHelper" ], "present": [ "WindowAdjustmentHelper" ], "absent": [] }
          },
          "screenshot": "helper-open"
        },
        {
          "id": "move-right",
          "key": "L",
          "modifiers": [],
          "expects": {
            "before": { "focus": [ "WindowAdjustmentHelper" ], "present": [ "WindowAdjustmentHelper" ], "absent": [] },
            "after": { "focus": [ "WindowAdjustmentHelper" ], "present": [ "WindowAdjustmentHelper" ], "absent": [] }
          },
          "measure": { "kind": "move", "dx": 1, "dy": 0 }
        },
        {
          "id": "move-left",
          "key": "H",
          "modifiers": [],
          "expects": {
            "before": { "focus": [ "WindowAdjustmentHelper" ], "present": [ "WindowAdjustmentHelper" ], "absent": [] },
            "after": { "focus": [ "WindowAdjustmentHelper" ], "present": [ "WindowAdjustmentHelper" ], "absent": [] }
          },
          "measure": { "kind": "move", "dx": -1, "dy": 0 }
        },
        {
          "id": "leave-escape",
          "key": "Escape",
          "modifiers": [],
          "expects": {
            "before": { "focus": [ "WindowAdjustmentHelper" ], "present": [ "WindowAdjustmentHelper" ], "absent": [] },
            "after": { "focus": [ "@entryFileList" ], "present": [], "absent": [ "WindowAdjustmentHelper" ] }
          },
          "measure": { "kind": "addressUnfocused" },
          "screenshot": "helper-left"
        }
      ]
    },
    {
      "id": "f7-name-entry",
      "mode": "Input",
      "status": "active",
      "steps": [
        {
          "id": "open-name-entry",
          "key": "F7",
          "modifiers": [],
          "expects": {
            "opensModal": "NameEntry",
            "before": { "focus": [ "LeftFileList", "RightFileList" ], "present": [], "absent": [ "NameEntry", "WindowAdjustmentHelper" ] },
            "after": { "focus": [ "NameEntry" ], "present": [ "NameEntry" ], "absent": [] }
          },
          "screenshot": "name-entry-open"
        },
        {
          "id": "cancel-escape",
          "key": "Escape",
          "modifiers": [],
          "expects": {
            "before": { "focus": [ "NameEntry" ], "present": [ "NameEntry" ], "absent": [] },
            "after": { "focus": [ "@entryFileList" ], "present": [], "absent": [ "NameEntry" ] }
          },
          "measure": { "kind": "addressUnfocused" },
          "screenshot": "name-entry-cancelled"
        }
      ]
    },
    { "id": "f2-rename-entry", "mode": "Input", "status": "skip", "reason": "not-implemented" },
    { "id": "f8-delete-confirmation", "mode": "Input", "status": "skip", "reason": "not-implemented", "note": "DeletionConfirmation is declared by the product, but the guarded F8 route and this Input cell remain unimplemented. F8 stays refused." },
    { "id": "transfer-conflict", "mode": "Input", "status": "skip", "reason": "not-implemented" },
    { "id": "settings-editor", "mode": "Input", "status": "skip", "reason": "not-implemented" },

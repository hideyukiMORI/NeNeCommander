                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel x:Name="BookmarkDraftFooter" Orientation="Horizontal" Spacing="{StaticResource SpacingOperationBarGap}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="BookmarkSave" x:Uid="BookmarkSave" />
                                <Button x:Name="BookmarkDraftCancel" x:Uid="BookmarkCancel" />
                            </StackPanel>
                            <StackPanel x:Name="BookmarkCategoryDraftFooter" Orientation="Horizontal" Spacing="{StaticResource SpacingOperationBarGap}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="BookmarkCategorySave" x:Uid="BookmarkSave" />
                                <Button x:Name="BookmarkCategoryCancel" x:Uid="BookmarkCancel" />
                            </StackPanel>
                            <StackPanel x:Name="BookmarkCategoryDeleteFooter" Orientation="Horizontal" Spacing="{StaticResource SpacingOperationBarGap}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="BookmarkCategoryDeleteConfirm" x:Uid="BookmarkCategoryDeleteConfirm" />
                                <Button x:Name="BookmarkCategoryDeleteCancel" x:Uid="BookmarkCancel" />
                            </StackPanel>
                            <StackPanel x:Name="BookmarkDeleteFooter" Orientation="Horizontal" Spacing="{StaticResource SpacingOperationBarGap}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="BookmarkDeleteConfirm" x:Uid="BookmarkDeleteConfirm" AutomationProperties.AutomationId="BookmarkDeleteConfirm" />
                                <Button x:Name="BookmarkDeleteCancel" x:Uid="BookmarkCancel" AutomationProperties.AutomationId="BookmarkDeleteCancel" />
                            </StackPanel>
                            <StackPanel x:Name="BookmarkNavigationFailedFooter" Orientation="Horizontal" Spacing="{StaticResource SpacingOperationBarGap}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="BookmarkNavigationRetry" x:Uid="BookmarkNavigationRetry" />
                                <Button x:Name="BookmarkNavigationCancel" x:Uid="BookmarkNavigationBack" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpacingRowGap}" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="BookmarkPersistenceLabel"
                                    x:Uid="BookmarkPersistenceLabel"
                                    FontFamily="{StaticResource TypographyMonospaceFamily}"
                                    FontSize="{StaticResource TypographyMonospaceSize}"
                                    Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock
                                    x:Name="BookmarkSaveStatus"
                                    AutomationProperties.AutomationId="BookmarkSaveStatus"
                                    AutomationProperties.LiveSetting="Polite"
                                    FontFamily="{StaticResource TypographyMonospaceFamily}"
                                    FontSize="{StaticResource TypographyMonospaceSize}"
                                    Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="OperationBar"
            x:Uid="OperationBarRegion"
            Grid.Row="2"
            AutomationProperties.AutomationId="OperationBar"
            Background="{StaticResource SurfacePaneBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="{StaticResource BorderOperationBarThickness}"
            CornerRadius="{StaticResource RadiusOperationBar}"
            MinHeight="{StaticResource DensityOperationBarHeight}"
            Padding="{StaticResource SpacingOperationBar}">
            <StackPanel
                x:Name="OperationContent"
                AutomationProperties.LabeledBy="{Binding ElementName=OperationStatus}"
                Spacing="{StaticResource SpacingOperationBarGap}">
                <views:KeyHintWrapPanel x:Name="OperationInformation" Visibility="Collapsed">
                    <Grid
                        x:Name="OperationStatusGroup"
                        ColumnSpacing="{StaticResource SpacingOperationBarGap}"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                            x:Name="OperationWarningIcon"
                            Data="M9,2.5 L16.5,15.5 L1.5,15.5 Z M9,6.8 L9,10.8 M9,12.8 L9,13.4"
                            Height="{StaticResource DensityOperationIconSize}"
                            StrokeLineJoin="Round"
                            StrokeThickness="{StaticResource DensityIconStrokeThickness}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Width="{StaticResource DensityOperationIconSize}" />
                        <Path
                            x:Name="OperationNameEntryIcon"
                            Data="M3,15 L6.2,15 L15,6.2 L11.8,3 L3,11.8 Z M10,4.8 L13.2,8"
                            Height="{StaticResource DensityOperationIconSize}"
                            StrokeLineJoin="Round"
                            StrokeThickness="{StaticResource DensityIconStrokeThickness}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Width="{StaticResource DensityOperationIconSize}" />
                        <TextBlock
                            x:Name="OperationStatus"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="OperationStatus"
                            FontSize="{StaticResource TypographyBodySize}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Border
                        x:Name="NameEntryFrame"
                        Background="{StaticResource SurfaceFieldBrush}"
                        BorderBrush="{StaticResource FocusRingBrush}"
                        BorderThickness="{StaticResource BorderNameEntryThickness}"
                        CornerRadius="{StaticResource RadiusNameEntry}"
                        Height="{StaticResource DensityNameEntryHeight}"
                        Padding="{StaticResource SpacingNameEntry}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Width="{StaticResource DensityNameEntryWidth}">
                        <TextBox
                            x:Name="NameEntry"
                            AutomationProperties.AutomationId="NameEntry"
                            FontSize="{StaticResource TypographyBodySize}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Style="{StaticResource PlainTextEditorStyle}" />
                    </Border>
                    <ItemsControl
                        x:Name="OperationProgressSegments"
                        AutomationProperties.AutomationId="OperationProgressSegments"
                        ItemTemplate="{StaticResource ProgressSegmentTemplate}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:KeyHintWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel
                        x:Name="OperationCounts"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="OperationDetailCount"
                            AutomationProperties.AutomationId="OperationDetail"
                            FontFamily="{StaticResource TypographyMonospaceFamily}"
                            FontSize="{StaticResource TypographyMonospaceSize}"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            x:Name="OperationProgressSeparator"
                            AutomationProperties.AutomationId="OperationProgressSeparator"
                            FontFamily="{StaticResource TypographyMonospaceFamily}"
                            FontSize="{StaticResource TypographyMonospaceSize}"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            x:Name="OperationTotal"
                            AutomationProperties.AutomationId="OperationTotal"
                            FontFamily="{StaticResource TypographyMonospaceFamily}"
                            FontSize="{StaticResource TypographyMonospaceSize}"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <views:KeyHintWrapPanel x:Name="TransferResultSegments" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingOperationDetailGap}">
                            <TextBlock x:Uid="TransferResultNotTransferred" />
                            <TextBlock x:Name="TransferResultNotTransferredCount" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingOperationDetailGap}">
                            <TextBlock x:Uid="TransferResultCopied" />
                            <TextBlock x:Name="TransferResultCopiedCount" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingOperationDetailGap}">
                            <TextBlock x:Uid="TransferResultVerified" />
                            <TextBlock x:Name="TransferResultVerifiedCount" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingOperationDetailGap}">
                            <TextBlock x:Uid="TransferResultSourceDeleted" />
                            <TextBlock x:Name="TransferResultSourceDeletedCount" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingOperationDetailGap}">
                            <TextBlock x:Uid="TransferResultSourcePartiallyDeleted" />
                            <TextBlock x:Name="TransferResultSourcePartiallyDeletedCount" />
                        </StackPanel>
                    </views:KeyHintWrapPanel>
                </views:KeyHintWrapPanel>
                <ItemsControl
                    x:Name="OperationKeyHints"
                    x:Uid="OperationKeyHintsRegion"
                    AutomationProperties.AutomationId="OperationKeyHints"
                    HorizontalAlignment="Right"
                    ItemTemplate="{StaticResource KeyHintTemplate}"
                    VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:KeyHintWrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid
            x:Name="AddressEditorOverlay"
            Grid.RowSpan="3"
            AutomationProperties.AutomationId="AddressEditorOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Canvas.ZIndex="20"
            Padding="{StaticResource SpacingWindowOuter}"
            Visibility="Collapsed">
            <Border
                x:Name="AddressEditorModal"
                AutomationProperties.AutomationId="AddressEditorModal"
                AutomationProperties.LabeledBy="{Binding ElementName=AddressEditorTitle}"
                Background="{StaticResource SurfacePaneBrush}"
                BorderBrush="{StaticResource FocusRingBrush}"
                BorderThickness="{StaticResource BorderOperationBarThickness}"
                CornerRadius="{StaticResource RadiusPane}"
                HorizontalAlignment="Stretch"
                Padding="{StaticResource SpacingWindowOuter}"
                TabFocusNavigation="Cycle"
                VerticalAlignment="Center">
                <StackPanel Spacing="{StaticResource SpacingOperationBarGap}">
                    <TextBlock
                        x:Name="AddressEditorTitle"
                        x:Uid="AddressEditorTitle"
                        FontSize="{StaticResource TypographyBodySize}"
                        FontWeight="Bold" />
                    <TextBox
                        x:Name="AddressEditorInput"
                        x:Uid="AddressEditorInput"
                        AutomationProperties.AutomationId="AddressEditorInput"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False" />
                    <TextBlock
                        x:Name="AddressEditorStatus"
                        AutomationProperties.AutomationId="AddressEditorStatus"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ItemsControl
                        x:Name="AddressEditorKeyHints"
                        AutomationProperties.AutomationId="AddressEditorKeyHints"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource KeyHintTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingOperationDetailGap}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="CommandPaletteOverlay"
            Grid.RowSpan="3"
            AutomationProperties.AutomationId="CommandPaletteOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Canvas.ZIndex="20"
            Visibility="Collapsed">
            <Border
                x:Name="CommandPaletteSurface"
                AutomationProperties.AutomationId="CommandPaletteSurface"
                Background="{StaticResource SurfacePaneBrush}"
                BorderBrush="{StaticResource FocusRingBrush}"
                BorderThickness="{StaticResource BorderOperationBarThickness}"
                CornerRadius="{StaticResource RadiusPane}"
                HorizontalAlignment="Stretch"
                Margin="{StaticResource SpacingCommandPaletteOuter}"
                MaxWidth="{StaticResource DensityCommandPaletteMaxWidth}"
                Padding="{StaticResource SpacingWindowOuter}"
                VerticalAlignment="Top">
                <Grid RowSpacing="{StaticResource SpacingOperationBarGap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="CommandPaletteContext"
                        AutomationProperties.AutomationId="CommandPaletteContext"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="CommandPaletteSearch"
                        x:Uid="CommandPaletteSearch"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="CommandPaletteSearch"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyBodySize}" />
                    <ListView
                        x:Name="CommandPaletteCandidateList"
                        x:Uid="CommandPaletteCandidateList"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="CommandPaletteCandidateList"
                        IsItemClickEnabled="True"
                        ItemContainerStyle="{StaticResource CommandPaletteRowContainerStyle}"
                        ItemTemplate="{StaticResource CommandPaletteRowTemplate}"
                        SelectionMode="Single">
                        <ListView.Resources>
                            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SelectionSurfaceBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SelectionSurfaceBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SelectionSurfaceBrush" />
                            <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="SelectionMarkBrush" />
                            <StaticResource x:Key="ListViewItemSelectionIndicatorPointerOverBrush" ResourceKey="SelectionMarkBrush" />
                            <StaticResource x:Key="ListViewItemSelectionIndicatorPressedBrush" ResourceKey="SelectionMarkBrush" />
                        </ListView.Resources>
                    </ListView>
                    <TextBlock
                        x:Name="CommandPaletteZeroResults"
                        x:Uid="CommandPaletteZeroResults"
                        Grid.Row="3"
                        AutomationProperties.AutomationId="CommandPaletteZeroResults"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <Border
                        Grid.Row="4"
                        AutomationProperties.AutomationId="CommandPaletteDetailBar"
                        Background="{StaticResource SurfaceFieldBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="{StaticResource BorderOperationBarThickness}"
                        CornerRadius="{StaticResource RadiusOperationBar}"
                        Padding="{StaticResource SpacingOperationBar}">
                        <TextBlock
                            x:Name="CommandPaletteDetail"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl
                        x:Name="CommandPaletteKeyHints"
                        Grid.Row="5"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource KeyHintTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:KeyHintWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="LocationsOverlay"
            Grid.RowSpan="3"
            AutomationProperties.AutomationId="LocationsOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Canvas.ZIndex="20"
            Visibility="Collapsed">
            <Border
                x:Name="LocationsModal"
                AutomationProperties.AutomationId="LocationsModal"
                Background="{StaticResource SurfacePaneBrush}"
                BorderBrush="{StaticResource FocusRingBrush}"
                BorderThickness="{StaticResource BorderOperationBarThickness}"
                CornerRadius="{StaticResource RadiusPane}"
                HorizontalAlignment="Stretch"
                Padding="{StaticResource SpacingWindowOuter}"
                VerticalAlignment="Top">
                <Grid RowSpacing="{StaticResource SpacingOperationBarGap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="LocationsTitle" FontSize="{StaticResource TypographyBodySize}" FontWeight="Bold" />
                    <TextBlock
                        x:Name="LocationsStatus"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="LocationsStatus"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="LocationsDrivesStatus"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="LocationsDrivesStatus"
                        Foreground="{StaticResource StatusWarningBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="LocationsWslStatus"
                        Grid.Row="3"
                        AutomationProperties.AutomationId="LocationsWslStatus"
                        Foreground="{StaticResource StatusWarningBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="LocationsList"
                        x:Uid="LocationsList"
                        Grid.Row="4"
                        AutomationProperties.AutomationId="LocationsList"
                        IsItemClickEnabled="True"
                        ItemTemplate="{StaticResource LocationRowTemplate}"
                        SelectionMode="Single" />
                    <ItemsControl
                        x:Name="LocationsKeyHints"
                        Grid.Row="5"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource KeyHintTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource SpacingOperationDetailGap}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="KeyboardHelpOverlay"
            Grid.RowSpan="3"
            AutomationProperties.AutomationId="KeyboardHelpOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Canvas.ZIndex="22"
            Padding="{StaticResource SpacingWindowOuter}"
            Visibility="Collapsed">
            <Border
                x:Name="KeyboardHelpSurface"
                Background="{StaticResource SurfacePaneBrush}"
                BorderBrush="{StaticResource FocusRingBrush}"
                BorderThickness="{StaticResource BorderOperationBarThickness}"
                CornerRadius="{StaticResource RadiusPane}"
                HorizontalAlignment="Center"
                Padding="{StaticResource SpacingWindowOuter}"
                VerticalAlignment="Center">
                <Grid RowSpacing="{StaticResource SpacingOperationBarGap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="KeyboardHelpTitle"
                        x:Uid="KeyboardHelpTitle"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="{StaticResource TypographyBodySize}"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Margin="{StaticResource SpacingWindowOuter}" />
                    <ScrollViewer
                        x:Name="KeyboardHelp"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="KeyboardHelp"
                        HorizontalScrollBarVisibility="Disabled"
                        IsTabStop="True"
                        VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="KeyboardHelpColumns">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsControl
                                x:Name="KeyboardHelpPrimaryGroups"
                                IsTabStop="False"
                                ItemTemplate="{StaticResource KeyboardHelpGroupTemplate}"
                                Width="{StaticResource DensityKeyboardHelpColumnWidth}" />
                            <ItemsControl
                                x:Name="KeyboardHelpSecondaryGroups"
                                Grid.Column="1"
                                IsTabStop="False"
                                ItemTemplate="{StaticResource KeyboardHelpGroupTemplate}"
                                Width="{StaticResource DensityKeyboardHelpColumnWidth}" />
                        </Grid>
                    </ScrollViewer>
                    <TextBlock
                        x:Uid="KeyboardHelpCloseNote"
                        Grid.Row="2"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="{StaticResource TypographyBodySize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="{StaticResource SpacingWindowOuter}" />
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="WindowAdjustmentOverlay"
            Grid.RowSpan="3"
            AutomationProperties.AutomationId="WindowAdjustmentOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Canvas.ZIndex="21"
            Padding="{StaticResource SpacingWindowOuter}"
            Visibility="Collapsed">
            <Border
                x:Name="WindowAdjustmentSurface"
                AutomationProperties.AutomationId="WindowAdjustmentSurface"
                Background="{StaticResource SurfacePaneBrush}"
                BorderBrush="{StaticResource FocusRingBrush}"
                BorderThickness="{StaticResource BorderOperationBarThickness}"
                CornerRadius="{StaticResource RadiusPane}"
                HorizontalAlignment="Center"
                Margin="{StaticResource SpacingWindowOuter}"
                Padding="{StaticResource SpacingOperationBar}"
                VerticalAlignment="Top">
                <StackPanel
                    Padding="{StaticResource SpacingWindowOuter}"
                    Spacing="{StaticResource SpacingOperationBarGap}">
                    <Grid ColumnSpacing="{StaticResource SpacingOperationDetailGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="{StaticResource SpacingKeyHintGap}"
                            VerticalAlignment="Center">
                            <Grid>
                                <ContentControl
                                    x:Name="WindowAdjustmentHelper"
                                    AutomationProperties.AutomationId="WindowAdjustmentHelper"
                                    AutomationProperties.LiveSetting="Polite"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="False"
                                    Visibility="Collapsed" />
                                <Path
                                    AutomationProperties.AccessibilityView="Raw"
                                    Data="M2,3.5 L16,3.5 L16,14.5 L2,14.5 Z M2,6.5 L16,6.5"
                                    Height="{StaticResource DensityOperationIconSize}"
                                    Stroke="{StaticResource FocusRingBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="{StaticResource DensityIconStrokeThickness}"
                                    VerticalAlignment="Center"
                                    Width="{StaticResource DensityOperationIconSize}" />
                            </Grid>
                            <TextBlock
                                x:Name="WindowAdjustmentTitle"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="{StaticResource TypographyBodySize}"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            x:Name="WindowAdjustmentOutcome"
                            Grid.Column="1"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="{StaticResource TypographyMonospaceFamily}"
                            FontSize="{StaticResource TypographyMonospaceSize}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl
                        x:Name="WindowAdjustmentKeyHints"
                        AutomationProperties.AccessibilityView="Raw"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource WindowAdjustmentKeyHintTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:KeyHintWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>

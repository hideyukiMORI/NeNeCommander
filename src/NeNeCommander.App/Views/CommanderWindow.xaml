<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeNeCommander.App.Views.CommanderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bookmarks="using:NeNeCommander.Presentation.WinUI.Bookmarks"
    xmlns:commands="using:NeNeCommander.Presentation.WinUI.Commands"
    xmlns:locations="using:NeNeCommander.Presentation.WinUI.Locations"
    xmlns:panes="using:NeNeCommander.Presentation.WinUI.Panes"
    xmlns:settings="using:NeNeCommander.Presentation.WinUI.Settings"
    xmlns:views="using:NeNeCommander.App.Views"
    Activated="OnActivated">
    <Grid x:Name="WindowFrame" Background="{StaticResource SurfaceWindowBrush}">
        <Grid.Resources>
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceWindowBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource BorderNoneThickness}" />
                <Setter Property="Padding" Value="{StaticResource SpacingNone}" />
                <Setter Property="MinHeight" Value="{StaticResource DensityNone}" />
                <Setter Property="MinWidth" Value="{StaticResource DensityNone}" />
                <Setter Property="Width" Value="{StaticResource DensityCaptionButtonWidth}" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CaptionGlyphStyle" TargetType="Path">
                <Setter Property="Height" Value="{StaticResource DensityCaptionGlyphSize}" />
                <Setter Property="Width" Value="{StaticResource DensityCaptionGlyphSize}" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="Stroke" Value="{StaticResource TextKeyHintBrush}" />
                <Setter Property="StrokeThickness" Value="{StaticResource DensityCaptionGlyphStrokeThickness}" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="CaptionBar"
            Background="{StaticResource SurfaceWindowBrush}"
            Height="{StaticResource DensityCaptionBarHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="CaptionDragArea" Background="{StaticResource SurfaceWindowBrush}">
                <TextBlock
                    x:Name="CaptionTitle"
                    AutomationProperties.AutomationId="CaptionTitle"
                    FontFamily="{StaticResource TypographyMonospaceFamily}"
                    FontSize="{StaticResource TypographyMonospaceSize}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="{StaticResource SpacingCaptionTitle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="CaptionMinimize"
                    x:Uid="CaptionMinimize"
                    AutomationProperties.AutomationId="CaptionMinimize"
                    Style="{StaticResource CaptionButtonStyle}">
                    <Path x:Name="CaptionMinimizeGlyph" Data="M0,5.5 L10,5.5" Style="{StaticResource CaptionGlyphStyle}" />
                </Button>
                <Button
                    x:Name="CaptionMaximize"
                    AutomationProperties.AutomationId="CaptionMaximize"
                    Style="{StaticResource CaptionButtonStyle}">
                    <Grid>
                        <Path
                            x:Name="CaptionMaximizeGlyph"
                            Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"
                            Style="{StaticResource CaptionGlyphStyle}" />
                        <Path
                            x:Name="CaptionRestoreGlyph"
                            Data="M0.5,2.5 L7.5,2.5 L7.5,9.5 L0.5,9.5 Z M2.5,2.5 L2.5,0.5 L9.5,0.5 L9.5,7.5 L7.5,7.5"
                            Style="{StaticResource CaptionGlyphStyle}"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button
                    x:Name="CaptionClose"
                    x:Uid="CaptionClose"
                    AutomationProperties.AutomationId="CaptionClose"
                    Style="{StaticResource CaptionButtonStyle}">
                    <Path x:Name="CaptionCloseGlyph" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Style="{StaticResource CaptionGlyphStyle}" />
                </Button>
            </StackPanel>
        </Grid>
    <!-- The dual-pane surface keeps its indentation from before Issue #379 so its history stays readable. -->
    <Grid
        x:Name="InputSurface"
        Grid.Row="1"
        AutomationProperties.AutomationId="CommanderDualPane"
        Background="{StaticResource SurfaceWindowBrush}"
        CharacterReceived="OnCharacterReceived"
        PreviewKeyDown="OnKeyDown"
        Loaded="OnLoaded"
        Padding="{StaticResource SpacingWindowContent}"
        RowSpacing="{StaticResource SpacingPaneGap}">
        <Grid.Resources>
            <views:SemanticResourceConverter x:Key="SemanticResourceConverter" />
            <views:LocalizedTextConverter x:Key="LocalizedTextConverter" />

            <Style x:Key="PlainTextEditorStyle" TargetType="TextBox">
                <Setter Property="BorderThickness" Value="{StaticResource BorderNoneThickness}" />
                <Setter Property="Padding" Value="{StaticResource SpacingNone}" />
                <Setter Property="MinHeight" Value="{StaticResource DensityNone}" />
                <Setter Property="MinWidth" Value="{StaticResource DensityNone}" />
                <Setter Property="FontFamily" Value="{StaticResource TypographyMonospaceFamily}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer
                                x:Name="ContentElement"
                                AutomationProperties.AccessibilityView="Raw"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                IsTabStop="False"
                                VerticalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Disabled"
                                ZoomMode="Disabled" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PaneRowContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="{StaticResource SpacingNone}" />
                <Setter Property="Padding" Value="{StaticResource SpacingNone}" />
                <Setter Property="MinHeight" Value="{StaticResource DensityNone}" />
                <Setter Property="Height" Value="{StaticResource DensityRowHeight}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="CommandPaletteRowContainerStyle"
                BasedOn="{StaticResource DefaultListViewItemStyle}"
                TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="{StaticResource DensityRowHeight}" />
                <Setter Property="Padding" Value="{StaticResource SpacingNone}" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <DataTemplate x:Key="PaneRowTemplate" x:DataType="panes:PaneRow">
                <Grid
                    AutomationProperties.Name="{x:Bind Entry.Name}"
                    Background="{Binding Mark.SurfaceBrushResourceKey, Converter={StaticResource SemanticResourceConverter}}"
                    ColumnSpacing="{StaticResource SpacingRowGap}"
                    Height="{StaticResource DensityRowHeight}"
                    Padding="{StaticResource SpacingRowContent}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Fill="{Binding Mark.MarkerBrushResourceKey, Converter={StaticResource SemanticResourceConverter}}"
                        Width="{StaticResource DensityRowMarkerWidth}" />
                    <Path
                        Grid.Column="1"
                        Data="M1.5,4 L6,4 L7.5,5.5 L14.5,5.5 L14.5,13 L1.5,13 Z"
                        Height="{StaticResource DensityKindIconSize}"
                        Stroke="{StaticResource FocusRingBrush}"
                        StrokeLineJoin="Round"
                        StrokeThickness="{StaticResource DensityIconStrokeThickness}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Kind.IsDirectory}"
                        Width="{StaticResource DensityKindIconSize}" />
                    <Path
                        Grid.Column="1"
                        Data="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5"
                        Height="{StaticResource DensityKindIconSize}"
                        Stroke="{StaticResource TextSecondaryBrush}"
                        StrokeLineJoin="Round"
                        StrokeThickness="{StaticResource DensityIconStrokeThickness}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Kind.IsFile}"
                        Width="{StaticResource DensityKindIconSize}" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="{StaticResource TypographyBodySize}"
                        Foreground="{Binding Visibility.NameBrushResourceKey, Converter={StaticResource SemanticResourceConverter}}"
                        Text="{x:Bind Entry.Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="3"
                        AutomationProperties.Name="{x:Bind SizeText}"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind SizeText}"
                        TextAlignment="Right"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center"
                        Width="{StaticResource DensityRowSizeWidth}" />
                    <TextBlock
                        Grid.Column="4"
                        AutomationProperties.Name="{x:Bind ModifiedText}"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind ModifiedText}"
                        TextAlignment="Right"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center"
                        Width="{StaticResource DensityRowModifiedWidth}" />
                    <TextBlock
                        Grid.Column="5"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyKindLabelSize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding Kind.LabelResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                        VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="KeyHintTemplate">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingKeyHintGap}"
                    VerticalAlignment="Center">
                    <Border
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="{StaticResource BorderKeyCapThickness}"
                        CornerRadius="{StaticResource RadiusKeyCap}"
                        Padding="{StaticResource SpacingKeyCap}"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="{StaticResource TypographyMonospaceFamily}"
                            FontSize="{StaticResource TypographyMonospaceSize}"
                            Foreground="{StaticResource TextKeyHintBrush}"
                            Text="{Binding KeyLabelResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        AutomationProperties.AutomationId="{Binding AutomationId}"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding IntentLabelResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                        TextLineBounds="Tight"
                        VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="KeyboardHelpCapTemplate">
                <Border
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="{StaticResource BorderKeyCapThickness}"
                    CornerRadius="{StaticResource RadiusKeyCap}"
                    Padding="{StaticResource SpacingKeyCap}"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        Foreground="{StaticResource TextKeyHintBrush}"
                        Text="{Binding Converter={StaticResource LocalizedTextConverter}}"
                        VerticalAlignment="Center" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="KeyboardHelpRowTemplate">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingOperationDetailGap}">
                    <ItemsControl
                        AutomationProperties.AccessibilityView="Raw"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource KeyboardHelpCapTemplate}"
                        ItemsSource="{Binding KeyLabelResourceKeys}"
                        VerticalAlignment="Center"
                        Width="{StaticResource DensityKeyboardHelpKeyColumnWidth}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource SpacingKeyHintGap}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock
                        FontSize="{StaticResource TypographyBodySize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding ActionLabelResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                        TextLineBounds="Tight"
                        VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="KeyboardHelpGroupTemplate">
                <StackPanel Margin="{StaticResource SpacingWindowOuter}" Spacing="{StaticResource SpacingKeyHintGap}">
                    <TextBlock
                        FontSize="{StaticResource TypographyBodySize}"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding TitleResourceKey, Converter={StaticResource LocalizedTextConverter}}" />
                    <ItemsControl
                        IsTabStop="False"
                        ItemTemplate="{StaticResource KeyboardHelpRowTemplate}"
                        ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SpacingKeyHintGap}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="WindowAdjustmentKeyHintTemplate">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingKeyHintGap}"
                    VerticalAlignment="Center">
                    <ItemsControl
                        IsTabStop="False"
                        ItemsSource="{Binding KeyLabelResourceKeys}"
                        VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource SpacingKeyHintGap}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="{StaticResource BorderKeyCapThickness}"
                                    CornerRadius="{StaticResource RadiusKeyCap}"
                                    Padding="{StaticResource SpacingKeyCap}"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                                        FontSize="{StaticResource TypographyMonospaceSize}"
                                        Foreground="{StaticResource TextKeyHintBrush}"
                                        Text="{Binding Converter={StaticResource LocalizedTextConverter}}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding IntentLabelResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                        TextLineBounds="Tight"
                        VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate
                x:Key="CommandPaletteRowTemplate"
                x:DataType="commands:CommandPaletteRow">
                <Grid
                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    ColumnSpacing="{StaticResource SpacingRowGap}"
                    Loaded="OnCommandPaletteRowLoaded"
                    MinHeight="{StaticResource DensityRowHeight}"
                    Padding="{StaticResource SpacingRowContent}">
                    <ToolTipService.ToolTip>
                        <ToolTip
                            Content="{x:Bind Title}"
                            IsEnabled="False" />
                    </ToolTipService.ToolTip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Foreground="{StaticResource StatusWarningBrush}"
                        Text="{x:Bind StateMarker}"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CommandPaletteTitle"
                            FontSize="{StaticResource TypographyBodySize}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            FontSize="{StaticResource TypographyMonospaceSize}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{x:Bind Target}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Foreground="{StaticResource StatusWarningBrush}"
                        Text="{x:Bind Reason}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center" />
                    <Border
                        Grid.Column="3"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="{StaticResource BorderKeyCapThickness}"
                        CornerRadius="{StaticResource RadiusKeyCap}"
                        Padding="{StaticResource SpacingKeyCap}"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="{StaticResource TypographyMonospaceFamily}"
                            FontSize="{StaticResource TypographyMonospaceSize}"
                            Foreground="{StaticResource TextKeyHintBrush}"
                            Text="{x:Bind Shortcut}" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ProgressSegmentTemplate">
                <Rectangle
                    Fill="{Binding BrushResourceKey, Converter={StaticResource SemanticResourceConverter}}"
                    Stroke="{StaticResource OperationProgressBrush}"
                    StrokeThickness="{StaticResource DensityIconStrokeThickness}"
                    Height="{StaticResource DensityProgressSegmentSize}"
                    Width="{StaticResource DensityProgressSegmentSize}" />
            </DataTemplate>

            <DataTemplate
                x:Key="SettingsLanguageOptionTemplate"
                x:DataType="settings:SettingsLanguageOption">
                <RadioButton
                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                    Checked="OnSettingsLanguageChecked"
                    Content="{Binding NameResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                    GroupName="SettingsInterfaceLanguages"
                    IsChecked="{x:Bind IsSelected, Mode=OneTime}" />
            </DataTemplate>
            <DataTemplate
                x:Key="SettingsSchemeOptionTemplate"
                x:DataType="settings:SettingsSchemeRow">
                <Grid
                    AutomationProperties.Name="{x:Bind Description}"
                    ToolTipService.ToolTip="{x:Bind Description}"
                    HorizontalAlignment="Stretch"
                    MinHeight="{StaticResource DensitySettingsSchemeRowMinHeight}"
                    Padding="{StaticResource SpacingThemePickerRow}">
                    <Grid ColumnSpacing="{StaticResource SpacingRowGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Appearance}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="BookmarkCategoryOptionTemplate" x:DataType="bookmarks:BookmarkCategoryOption">
                <TextBlock Text="{x:Bind DisplayText}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>

            <Style x:Key="BookmarkRowContainerStyle" BasedOn="{StaticResource PaneRowContainerStyle}" TargetType="ListViewItem">
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="BookmarkKeyHintButtonStyle" TargetType="Button">
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="Background" Value="{StaticResource SurfacePaneBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource BorderNoneThickness}" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="MinHeight" Value="{StaticResource DensityNone}" />
                <Setter Property="MinWidth" Value="{StaticResource DensityNone}" />
                <Setter Property="Padding" Value="{StaticResource SpacingNone}" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="BookmarkKeyHintTemplate" x:DataType="bookmarks:BookmarkManagerKeyHint">
                <Button
                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                    AutomationProperties.Name="{Binding LabelResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                    Click="OnBookmarkKeyHintClick"
                    IsEnabled="{x:Bind IsInvocable}"
                    Style="{StaticResource BookmarkKeyHintButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingKeyHintGap}">
                        <ItemsControl
                            AutomationProperties.AccessibilityView="Raw"
                            IsTabStop="False"
                            ItemTemplate="{StaticResource KeyboardHelpCapTemplate}"
                            ItemsSource="{x:Bind KeyLabelResourceKeys}"
                            VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingKeyHintGap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="{StaticResource TypographyMonospaceFamily}"
                            FontSize="{StaticResource TypographyMonospaceSize}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding LabelResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                            TextLineBounds="Tight"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="BookmarkCategoryRowTemplate" x:DataType="bookmarks:BookmarkCategoryOption">
                <Grid
                    Background="{Binding Mark.SurfaceBrushResourceKey, Converter={StaticResource SemanticResourceConverter}}"
                    ColumnSpacing="{StaticResource SpacingRowGap}"
                    Height="{StaticResource DensityRowHeight}"
                    Padding="{StaticResource SpacingRowContent}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Fill="{Binding Mark.MarkerBrushResourceKey, Converter={StaticResource SemanticResourceConverter}}"
                        Width="{StaticResource DensityRowMarkerWidth}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="{StaticResource TypographyBodySize}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{x:Bind DisplayText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="2"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind EntryCountText}"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="BookmarkRowTemplate" x:DataType="bookmarks:BookmarkRow">
                <Grid
                    Background="{Binding Mark.SurfaceBrushResourceKey, Converter={StaticResource SemanticResourceConverter}}"
                    ColumnSpacing="{StaticResource SpacingRowGap}"
                    Height="{StaticResource DensityRowHeight}"
                    Padding="{StaticResource SpacingRowContent}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Fill="{Binding Mark.MarkerBrushResourceKey, Converter={StaticResource SemanticResourceConverter}}"
                        Width="{StaticResource DensityRowMarkerWidth}" />
                    <TextBlock
                        Grid.Column="1"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        Foreground="{StaticResource FocusRingBrush}"
                        Text="{Binding ShortcutLabelResourceKey, Converter={StaticResource LocalizedTextConverter}}"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center"
                        Width="{StaticResource DensityBookmarkSlotColumnWidth}" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="{StaticResource TypographyBodySize}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{x:Bind NameText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center"
                        Width="{StaticResource DensityBookmarkNameColumnWidth}" />
                    <TextBlock
                        Grid.Column="3"
                        FontFamily="{StaticResource TypographyMonospaceFamily}"
                        FontSize="{StaticResource TypographyMonospaceSize}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind PathText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="LocationRowTemplate" x:DataType="locations:LocationRow">
                <Grid
                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    ColumnSpacing="{StaticResource SpacingRowGap}"
                    Padding="{StaticResource SpacingRowContent}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource TypographyMonospaceFamily}" Text="{x:Bind NameText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind DetailText}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="BookmarkShortcutOptionTemplate" x:DataType="bookmarks:BookmarkShortcutOption">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingRowGap}">
                    <TextBlock Text="{Binding LabelResourceKey, Converter={StaticResource LocalizedTextConverter}}" />
                    <TextBlock Text="{x:Bind AssignedBookmarkName}" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="{StaticResource SpacingPaneGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="LeftPaneBorder"
                x:Uid="LeftPaneRegion"
                Grid.Column="0"

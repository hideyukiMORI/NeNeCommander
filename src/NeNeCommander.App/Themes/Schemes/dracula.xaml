<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SurfaceWindowColor">#FF21222C</Color>
    <Color x:Key="SurfacePaneColor">#FF282A36</Color>
    <Color x:Key="SurfaceFieldColor">#FF21222C</Color>
    <Color x:Key="TextPrimaryColor">#FFF8F8F2</Color>
    <Color x:Key="TextSecondaryColor">#FF8490C0</Color>
    <Color x:Key="TextHiddenColor">#FF6272A4</Color>
    <Color x:Key="TextKeyHintColor">#FFF8F8F2</Color>
    <Color x:Key="BorderSubtleColor">#FF44475A</Color>
    <Color x:Key="FocusRingColor">#FFBD93F9</Color>
    <Color x:Key="FocusSurfaceColor">#FF3B3554</Color>
    <Color x:Key="SelectionSurfaceColor">#FF2C3F36</Color>
    <Color x:Key="SelectionMarkColor">#FF50FA7B</Color>
    <Color x:Key="StatusWarningColor">#FFFFB86C</Color>
    <Color x:Key="StatusWarningSurfaceColor">#FF3D3128</Color>
    <Color x:Key="StatusDangerColor">#FFFF5555</Color>
    <Color x:Key="StatusDangerSurfaceColor">#FF402A2E</Color>
    <Color x:Key="OperationProgressColor">#FFBD93F9</Color>
    <Color x:Key="OperationTrackColor">#FF44475A</Color>

    <SolidColorBrush x:Key="SurfaceWindowBrush" Color="{StaticResource SurfaceWindowColor}" />
    <SolidColorBrush x:Key="SurfacePaneBrush" Color="{StaticResource SurfacePaneColor}" />
    <SolidColorBrush x:Key="SurfaceFieldBrush" Color="{StaticResource SurfaceFieldColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextHiddenBrush" Color="{StaticResource TextHiddenColor}" />
    <SolidColorBrush x:Key="TextKeyHintBrush" Color="{StaticResource TextKeyHintColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
    <SolidColorBrush x:Key="FocusSurfaceBrush" Color="{StaticResource FocusSurfaceColor}" />
    <SolidColorBrush x:Key="SelectionSurfaceBrush" Color="{StaticResource SelectionSurfaceColor}" />
    <SolidColorBrush x:Key="SelectionMarkBrush" Color="{StaticResource SelectionMarkColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusWarningSurfaceBrush" Color="{StaticResource StatusWarningSurfaceColor}" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />
    <SolidColorBrush x:Key="StatusDangerSurfaceBrush" Color="{StaticResource StatusDangerSurfaceColor}" />
    <SolidColorBrush x:Key="OperationProgressBrush" Color="{StaticResource OperationProgressColor}" />
    <SolidColorBrush x:Key="OperationTrackBrush" Color="{StaticResource OperationTrackColor}" />
</ResourceDictionary>

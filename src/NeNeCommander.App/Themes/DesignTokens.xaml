<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SurfaceWindowColor">#FFF3F3F3</Color>
    <Color x:Key="SurfacePaneColor">#FFFFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FF1F1F1F</Color>
    <Color x:Key="BorderSubtleColor">#FFD0D0D0</Color>
    <Color x:Key="FocusRingColor">#FF5B5FC7</Color>
    <Color x:Key="SelectionSurfaceColor">#FFDDE4FF</Color>
    <Color x:Key="StatusWarningColor">#FF8A4B08</Color>
    <Color x:Key="OperationProgressColor">#FF5B5FC7</Color>

    <SolidColorBrush x:Key="SurfaceWindowBrush" Color="{StaticResource SurfaceWindowColor}" />
    <SolidColorBrush x:Key="SurfacePaneBrush" Color="{StaticResource SurfacePaneColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
    <SolidColorBrush x:Key="SelectionSurfaceBrush" Color="{StaticResource SelectionSurfaceColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="OperationProgressBrush" Color="{StaticResource OperationProgressColor}" />

    <Thickness x:Key="SpacingWindowOuter">16</Thickness>
    <Thickness x:Key="SpacingPaneInner">12</Thickness>
    <Thickness x:Key="SpacingAddressBottom">0,0,0,8</Thickness>
    <x:Double x:Key="SpacingPaneGap">12</x:Double>
    <x:Double x:Key="TypographyPaneTitleSize">18</x:Double>
    <x:Double x:Key="TypographyBodySize">14</x:Double>
    <CornerRadius x:Key="RadiusPane">8</CornerRadius>
    <x:Double x:Key="ElevationPaneTranslation">2</x:Double>
    <x:Double x:Key="DensityRowMinimumHeight">36</x:Double>
    <Duration x:Key="MotionStandardDuration">0:0:0.160</Duration>
</ResourceDictionary>
